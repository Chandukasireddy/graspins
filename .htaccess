# ============================================================
#  Graspins — Apache config for HostGator (static site)
#  Clean URLs + HTTPS + compression + long-term caching
# ============================================================

# Default document for "/"
DirectoryIndex index.html

# ------------------------------------------------------------
#  URL rewriting
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Force non-www canonical (graspins.com, not www.graspins.com)
  #    Flip this block if you prefer www as canonical.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3) Hide index.html  ->  redirect /index.html to /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # 4) Drop the .html extension for other pages
  #    /careers.html  ->  /careers   (301, so the clean URL is canonical)
  RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 5) Internally serve the .html file for an extensionless request
  #    /careers  ->  careers.html  (no redirect, URL stays clean)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ------------------------------------------------------------
#  Compression (smaller transfers = faster on poor networks)
# ------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json image/svg+xml application/xml font/woff2 font/woff
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml font/woff2 font/woff
</IfModule>

# ------------------------------------------------------------
#  Caching
#  - HTML: always revalidate (so content updates show immediately)
#  - CSS/JS/images/fonts: cache 1 year (bust via ?v=2 when you change them)
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Long-lived, immutable cache for fingerprintable static assets
  <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must always be re-checked so new deploys are seen instantly
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Basic security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
</IfModule>

# ------------------------------------------------------------
#  Nice 404 (optional — create 404.html to use it)
# ------------------------------------------------------------
# ErrorDocument 404 /404.html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
